{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blossomos-website",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-25",
	// node:crypto and Buffer (used by the newsletter API routes) need this
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// non-secret values can live here as "vars"; set actual secrets with
	// `wrangler secret put RESEND_API_KEY` / `NEWSLETTER_SECRET` / etc.
	"vars": {},
	"routes": [
		{
			"pattern": "blossomos.org",
			"zone_name": "blossomos.org",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
